# ---- Client (exposed to browser, safe) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server only (Netlify env vars, NEVER prefixed with VITE_) ----
# Set these in the Netlify dashboard under Site settings > Environment variables.
# They are read only inside netlify/functions and never shipped to the browser.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_PLACES_KEY=your-google-places-api-key
